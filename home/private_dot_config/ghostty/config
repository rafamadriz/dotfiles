theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-size = 14.5
font-family = Iosevka
# font-family = Aporetic Sans Mono
# font-family = Aporetic Serif Mono
# font-family = JetBrains Mono
# font-family = CommitMono
# font-family = Cascadia Mono
# font-family = Fira Code

# disable all ligatures
font-feature = -liga
font-feature = -calt
font-feature = -dlig

mouse-hide-while-typing = true
maximize = true

command = /usr/bin/env zsh --login -c "if [ -x "$(command -v tmux)" ] && [ -n "${DISPLAY}" ] && [ -z "${TMUX}" ]; then tmux new-session -A -s main >/dev/null 2>&1; fi"

# don't confirm when closing window/terminal
confirm-close-surface = false

# keep Ghostty running all the time so that new window creation will always be fast
# Better if used with systemd: systemctl enable --user app-com.mitchellh.ghostty.service
# https://ghostty.org/docs/linux/systemd
quit-after-last-window-closed = false

# Vim mode (somewhat) https://github.com/ghostty-org/ghostty/discussions/3708#discussioncomment-15329614

