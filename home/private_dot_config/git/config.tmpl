[user]
  email = {{ .email }}
  name = {{ .name }}

[core]
  editor = nvim

[init]
    defaultBranch = main

[color]
    ui = auto

[commit]
  template = ~/.config/git/gitmessage
  gpgsign = false
  verbose = true

[merge]
    tool = nvimdiff
    conflictStyle = zdiff3

[mergetool]
    keepBackup = false

[mergetool "nvimdiff"]
    layout = "LOCAL,BASE,REMOTE / MERGED"

[alias]
    lg    = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    dlg   = log -p --cc --graph --decorate
    wtf   = log --pretty=format:"%C(auto,yellow)%h%C(auto)%d%C(auto,reset)\\ by\\ %C(auto,blue)%an%C(auto,reset),\\ %C(auto,cyan)%ar%C(auto,reset)%n\\ %s%n" --stat
    ls    = ls-files
    sw    = switch
    co    = checkout
    tree  = log --all --graph --decorate --oneline --simplify-by-decoration
    fixup = commit --amend --no-edit --allow-empty
    root  = rev-parse --show-toplevel

{{- if lookPath "delta" }}
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[include]
    path = ./catppuccin.gitconfig

[delta]
    ; features = catppuccin-mocha
    navigate = true
    line-numbers = true
    hyperlinks = true
    ; side-by-side = true
{{- end }}
